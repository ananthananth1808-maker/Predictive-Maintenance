# Database Configuration
# LOCAL/MANUAL SETUP: Uses SQLite (file-based, no server required)
DATABASE_URL=sqlite:///./maintenai.db

# ML Model Paths (relative to project root)
ML_MODEL_PATH=ml/models/predictive_maintenance_model.pkl
PREPROCESSOR_PATH=ml/models/preprocessor.pkl

# LLM Configuration (OPTIONAL)
# Leave LLM_API_KEY empty to use rule-based analysis fallback
# Do NOT commit real API keys to .env.example

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Backend CORS Configuration
# FRONTEND_URL is used to set allowed origins in CORS middleware
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Frontend Configuration (Build-time)
# Set during frontend build process (e.g., npm run build)
# Used to point frontend to backend API
VITE_API_URL=http://localhost:8000/api/v1
