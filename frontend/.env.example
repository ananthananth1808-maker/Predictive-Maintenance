# Frontend Environment Variables (Vite build-time configuration)
# These are processed during the build step and embedded in the compiled frontend code.

# Backend API URL
# Default: http://localhost:8000/api/v1 (for local development)
# For production builds, set to your backend server URL before building:
#   npm run build   (uses VITE_API_URL from environment)
# Example: VITE_API_URL=https://api.production.com/api/v1 npm run build
VITE_API_URL=http://localhost:8000/api/v1
